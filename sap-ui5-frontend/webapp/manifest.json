{
  "_version": "1.32.0",
  "sap.app": {
    "id": "foresight.ui",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "title": "FORESIGHT Decision Console",
    "description": "Decision and Commitment Control Plane for Autonomous Supply Chains",
    "crossNavigation": {
      "inbounds": {
        "foresight-recovery-mission": {
          "semanticObject": "SupplyChain",
          "action": "manageRecovery",
          "title": "FORESIGHT Recovery Mission",
          "subTitle": "Decision & Commitment Control Plane",
          "icon": "sap-icon://clinical-task-tracker"
        }
      }
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/foresight/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    },
    "sourceTemplate": {
      "id": "@sap/ux-app-migrator:freestyle",
      "version": "1.33.0",
      "toolsId": "ee8aca93-87d0-46b8-82c9-b904ce3356ff"
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "foresight"
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://clinical-task-tracker",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.108.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.f": {},
        "sap.ui.layout": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "foresight.ui.i18n.i18n"
        }
      },
      "": {
        "type": "sap.ui.model.json.JSONModel",
        "dataSource": "mainService"
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "async": true,
        "viewPath": "foresight.ui.view",
        "controlAggregation": "pages",
        "controlId": "app",
        "clearControlAggregation": false
      },
      "routes": [
        {
          "name": "RouteApp",
          "pattern": "",
          "target": [
            "TargetApp"
          ]
        }
      ],
      "targets": {
        "TargetApp": {
          "viewType": "XML",
          "transition": "slide",
          "clearControlAggregation": false,
          "viewId": "App",
          "viewName": "App"
        }
      }
    },
    "rootView": {
      "viewName": "foresight.ui.view.App",
      "type": "XML",
      "async": true,
      "id": "App"
    }
  }
}
